    <string name="arkui_font_family">系统字体</string>
    <string name="arkui_font_sample">Aa · 0123456789\n清晰呈现每一个字</string>
    <string name="arkui_font_size_title">文字大小与字重</string>
    <string name="arkui_font_size_summary">结合预览调节字体大小、显示大小与粗体文字</string>
    <string name="arkui_font_note">默认字体仍为 Google Sans Flex。选择后即时更新系统界面字体；应用自带字体可能保持原样。字体未覆盖的字符（如部分字体中的中文）会使用系统回退字体。字体许可可在系统开源许可中查看。</string>
    <string name="arkui_personalization_save_error">无法保存此选择</string>
    <string name="arkui_compatibility_title">高级兼容性</string>
    <string name="arkui_compatibility_summary">截图限制、APK 签名与应用降级</string>
    <string name="arkui_capture_category">屏幕截取</string>
    <string name="arkui_install_category">应用安装</string>
    <string name="arkui_ignore_secure_title">忽略禁止截图标识符</string>
    <string name="arkui_ignore_secure_summary">截图与录屏时忽略应用窗口的 FLAG_SECURE。设备管理策略与敏感内容保护仍生效，受 DRM 保护的视频可能仍显示黑屏。</string>
    <string name="arkui_block_capture_detection_title">屏蔽截图检测</string>
    <string name="arkui_block_capture_detection_summary">不向应用发送 Android 系统截图回调。应用仍可能采用其他检测方式。</string>
    <string name="arkui_disable_signature_title">允许跨签名安装</string>
    <string name="arkui_disable_signature_summary">允许不同签名的 APK 覆盖普通应用并保留数据，对所有用户生效，不包含系统应用与共享 UID。此项不会关闭 APK 完整性或签名权限校验。</string>
    <string name="arkui_disable_apk_signature_title">关闭 APK 安装签名校验</string>
    <string name="arkui_disable_apk_signature_summary">允许安装签名后内容被修改的 APK，仍需包含可读取的签名证书。与跨签名安装独立，对所有用户生效。APEX 与增量安装仍按正常规则校验。</string>
    <string name="arkui_downgrade_title">允许应用降级</string>
    <string name="arkui_downgrade_summary">无需卸载即可覆盖安装普通应用的旧版本，对所有用户生效。旧版本可能无法读取新版本创建的数据。</string>
    <string name="arkui_compatibility_owner_note">安装的 APK 由所有用户共用，因此仅设备主用户可以修改安装兼容性。</string>
    <string name="arkui_compatibility_note">所有选项默认关闭，无需重启即可生效。忽略截图限制会允许截取私密界面；允许不同签名覆盖会让替换后的应用读取原应用数据；关闭 APK 校验会允许安装内容被修改的安装包。按实际需要启用。</string>
