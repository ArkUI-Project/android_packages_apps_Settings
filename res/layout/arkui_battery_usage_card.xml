<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/arkui_battery_daily_usage"
            android:textSize="22sp"
            android:textColor="?android:attr/textColorPrimary" />
        <TextView
            android:id="@+id/chart_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/arkui_battery_usage_estimate"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView
            android:id="@+id/battery_daily_usage_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="—"
            android:textSize="40sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/colorAccent" />
        <TextView
            android:id="@+id/battery_selected_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/arkui_battery_usage_unavailable"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />
        <LinearLayout
            android:id="@+id/battery_chart_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.android.settings.fuelgauge.batteryusage.BatteryChartView
                android:id="@+id/daily_battery_chart"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:contentDescription="@string/daily_battery_usage_chart"
                android:textAppearance="?android:attr/textAppearanceSmall"
                settings:textColor="?android:attr/textColorSecondary" />
            <TextView
                android:id="@+id/battery_hourly_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/arkui_battery_level_history"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />
            <com.android.settings.fuelgauge.batteryusage.BatteryChartView
                android:id="@+id/hourly_battery_chart"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:visibility="gone"
                android:alpha="0"
                android:contentDescription="@string/hourly_battery_usage_chart"
                android:textAppearance="?android:attr/textAppearanceSmall"
                settings:textColor="?android:attr/textColorSecondary" />
            <LinearLayout
                android:id="@+id/battery_level_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/arkui_battery_level_legend"
                    android:textSize="12sp"
                    android:textColor="?android:attr/colorAccent" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/arkui_battery_low_legend"
                    android:textSize="12sp"
                    android:textColor="@*android:color/materialColorTertiary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/arkui_battery_recovery_legend"
                    android:textSize="12sp"
                    android:textColor="@*android:color/materialColorSecondary" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@*android:color/materialColorOutlineVariant" />
        <TextView
            android:id="@+id/battery_usage_time_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/arkui_battery_screen_on"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary" />
                <TextView
                    android:id="@+id/battery_screen_on_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="—"
                    android:textSize="22sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/arkui_battery_screen_off"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary" />
                <TextView
                    android:id="@+id/battery_screen_off_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="—"
                    android:textSize="22sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/companion_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12dp" />
    </LinearLayout>
</FrameLayout>
