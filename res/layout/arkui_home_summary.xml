<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/arkui_home_device_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="112dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/arkui_home_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:src="@drawable/arkui_logo"
                android:scaleType="fitStart"
                android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                android:contentDescription="@string/arkui_about_brand"/>
            <TextView
                android:id="@+id/arkui_home_device_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="20sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/arkui_home_battery_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="112dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/arkui_home_pill"
            android:clipToOutline="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ProgressBar
                android:id="@+id/arkui_home_battery_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressDrawable="@drawable/arkui_home_progress"
                android:progressTint="@color/settingslib_materialColorPrimaryContainer"
                android:progressBackgroundTint="@color/settingslib_materialColorSecondaryContainer"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/arkui_home_battery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="42sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/settingslib_materialColorOnPrimaryContainer"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/arkui_home_android_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="112dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/arkui_home_android_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arkui_home_android_label"
                android:textSize="16sp"
                android:textColor="@color/settingslib_materialColorOnTertiaryContainer"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/arkui_home_android_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/settingslib_materialColorOnTertiaryContainer"/>
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_android"
                    android:tint="@color/settingslib_materialColorOnTertiaryContainer"
                    android:alpha="0.3"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/arkui_home_storage_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="112dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/arkui_home_card"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/storage_settings"
                android:textSize="16sp"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer"/>
            <TextView
                android:id="@+id/arkui_home_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer"/>
            <ProgressBar
                android:id="@+id/arkui_home_storage_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progressDrawable="@drawable/arkui_home_progress"
                android:progressTint="@color/settingslib_materialColorPrimary"
                android:progressBackgroundTint="@color/settingslib_materialColorPrimaryContainer"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
