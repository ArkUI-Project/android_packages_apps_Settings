<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/credential_prompt"
    android:importantForAccessibility="yes"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:filterTouchesWhenObscured="true">
    <LinearLayout android:id="@+id/credential_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:paddingHorizontal="28dp" android:paddingVertical="24dp">
        <ImageView android:id="@+id/app_lock_icon"
            android:layout_width="88dp" android:layout_height="88dp"
            android:importantForAccessibility="no" android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_security_filled" />
        <TextView android:id="@+id/app_lock_message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:gravity="center"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Headline" />
        <TextView android:id="@+id/app_lock_subtitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="@string/arkui_app_lock_auth_description"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium" />
        <FrameLayout android:id="@+id/app_lock_password_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/app_lock_verify"
            style="@style/SettingsLibButtonStyle.Expressive.Filled.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:filterTouchesWhenObscured="true"
            android:text="@string/arkui_app_lock_auth_button" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/app_lock_cancel"
            style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:filterTouchesWhenObscured="true"
            android:text="@android:string/cancel" />
    </LinearLayout>
</ScrollView>
