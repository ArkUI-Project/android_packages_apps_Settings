<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/arkui_about_hero">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings_security_filled"
            android:tint="@color/settingslib_materialColorOnPrimaryContainer"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/arkui_security_overview_title"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/arkui_security_overview_summary"
            android:textSize="16sp"
            android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />
    </LinearLayout>
</LinearLayout>
