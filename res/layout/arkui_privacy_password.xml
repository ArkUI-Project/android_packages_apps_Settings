<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:filterTouchesWhenObscured="true">
    <LinearLayout android:id="@+id/privacy_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp"
        android:paddingTop="32dp" android:paddingBottom="24dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp"
            android:importantForAccessibility="no" android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_privacy_filled" />
        <TextView android:id="@+id/privacy_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textSize="32sp"
            android:textColor="?android:attr/textColorPrimary" />
        <TextView android:id="@+id/privacy_description"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/privacy_type_group"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight"
            style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" app:singleSelection="true"
            app:selectionRequired="true" app:checkedButton="@id/privacy_pin_type">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/privacy_pin_type" style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="56dp" android:text="@string/arkui_privacy_password_pin" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/privacy_custom_type" style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="56dp" android:text="@string/arkui_privacy_password_custom" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <FrameLayout android:id="@+id/privacy_input_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacy_primary" style="@style/SettingsLibButtonStyle.Expressive.Filled.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:filterTouchesWhenObscured="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacy_apps" style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/arkui_app_lock_title"
            android:filterTouchesWhenObscured="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacy_disable" style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/arkui_privacy_password_disable"
            android:filterTouchesWhenObscured="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacy_cancel" style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@android:string/cancel"
            android:filterTouchesWhenObscured="true" />
    </LinearLayout>
</ScrollView>
