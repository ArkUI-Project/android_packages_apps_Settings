<resources>
    <string name="arkui_smart_pixels_title">像素省電</string>
    <string name="arkui_smart_pixels_summary">關閉部分 OLED 像素，降低螢幕功耗</string>
    <string name="arkui_smart_pixels_enable">使用像素省電</string>
    <string name="arkui_smart_pixels_intro">在螢幕上顯示細密的黑色像素圖案，降低 OLED 螢幕功耗。</string>
    <string name="arkui_smart_pixels_options">像素設定</string>
    <string name="arkui_smart_pixels_percent">關閉像素比例</string>
    <string name="arkui_smart_pixels_percent_value">約 %1$d%%</string>
    <string name="arkui_smart_pixels_saver_only">僅在省電模式下啟用</string>
    <string name="arkui_smart_pixels_saver_only_summary">隨系統省電模式自動套用像素圖案</string>
    <string name="arkui_smart_pixels_note">適用於 OLED 螢幕，LCD 螢幕無法獲得同等省電效果。啟用後畫面會變暗、細節會減少；關閉像素的比例不代表實際省電比例。圖案每分鐘位移，關閉螢幕、鎖定螢幕與生物辨識驗證期間自動暫停。螢幕截圖與錄影保持清晰。</string>
</resources>
