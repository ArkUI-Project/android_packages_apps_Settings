<resources>
    <string name="arkui_small_window_title">小視窗</string>
    <string name="arkui_small_window_summary">以可移動的小視窗開啟應用程式，隨時切換使用</string>
    <string name="arkui_small_window_enable">使用小視窗</string>
    <string name="arkui_small_window_launch">開啟方式</string>
    <string name="arkui_small_window_recents">最近使用的應用程式入口</string>
    <string name="arkui_small_window_recents_summary">在最近使用的應用程式選單中顯示「小視窗」</string>
    <string name="arkui_small_window_exceptions">一律以全螢幕開啟</string>
    <string name="arkui_small_window_exceptions_description">所選的應用程式一律以全螢幕開啟，包括從最近使用的應用程式及通知開啟。已在小視窗中的應用程式被選取後會恢復全螢幕。</string>
    <string name="arkui_small_window_notification_portrait">直向時從通知開啟</string>
    <string name="arkui_small_window_notification_landscape">橫向時從通知開啟</string>
    <string name="arkui_small_window_notification_summary">解鎖後，輕觸支援的通知時以小視窗開啟應用程式</string>
    <string name="arkui_small_window_notification_exceptions">通知開啟例外</string>
    <string name="arkui_small_window_notification_exceptions_description">所選的應用程式從通知開啟時使用一般方式；若未設為一律全螢幕，仍可透過最近使用的應用程式進入小視窗。</string>
    <string name="arkui_small_window_appearance">視窗大小</string>
    <string name="arkui_small_window_size">初始小視窗大小</string>
    <string name="arkui_small_window_pinned_size">初始浮動預覽大小</string>
    <string name="arkui_small_window_size_summary">預設大小套用至新建立的小視窗，已開啟的視窗保留目前大小。</string>
    <string name="arkui_small_window_interaction">手勢與回饋</string>
    <string name="arkui_small_window_single_tap">輕觸小視窗外部</string>
    <string name="arkui_small_window_double_tap">輕觸兩下小視窗外部</string>
    <string name="arkui_small_window_edge_dock">浮動預覽貼邊收起</string>
    <string name="arkui_small_window_edge_dock_summary">將浮動預覽拖向螢幕左右邊緣以收起，輕觸邊緣標籤即可恢復</string>
    <string name="arkui_small_window_edge_dock_foreground">貼邊小視窗視為前景</string>
    <string name="arkui_small_window_edge_dock_foreground_summary">開啟後，貼邊收起的應用程式保持活動狀態。關閉後，收起的應用程式轉入背景，影片或遊戲可能暫停；輕觸邊緣標籤即可恢復。</string>
    <string name="arkui_small_window_haptics">手勢震動</string>
    <string name="arkui_small_window_haptics_summary">系統觸控震動開啟時，在手勢觸發位置提供震動回饋</string>
    <string name="arkui_small_window_reset">還原預設設定</string>
    <string name="arkui_small_window_reset_summary">重設小視窗選項並清除應用程式例外</string>
    <string name="arkui_small_window_reset_message">要還原所有小視窗預設設定並清除兩類應用程式例外嗎？小視窗、最近使用的應用程式入口及貼邊小視窗視為前景將開啟；上滑進入浮動預覽、通知下拉小視窗及點擊通知開啟小視窗將關閉。</string>
    <string name="arkui_small_window_help">開啟最近使用的應用程式，輕觸應用程式選單並選擇「小視窗」。長按視窗操作列後拖曳可移動視窗，直接拖曳操作列可調整大小；縮小或放大超過震動提示位置，可分別最小化或恢復全螢幕。浮動預覽可拖曳，輕觸返回小視窗，輕觸兩下全螢幕，長按顯示應用程式靜音及大小切換按鈕。靜音在應用程式處於小視窗期間生效。將預覽拖到底部關閉區域即可收起。關閉此功能時，現有小視窗恢復全螢幕。顯示異常的應用程式可加入「一律以全螢幕開啟」。</string>
    <string name="arkui_small_window_apps_loading">正在載入應用程式…</string>
    <string name="arkui_small_window_apps_none">未選取應用程式</string>
    <string name="arkui_small_window_save_error">無法儲存小視窗設定</string>
