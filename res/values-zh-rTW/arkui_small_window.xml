        <item>較大</item>
    </string-array>
    <string-array name="arkui_small_window_pinned_sizes">
        <item>精簡</item>
        <item>較大</item>
    </string-array>
    <string-array name="arkui_small_window_tap_actions">
        <item>最小化為浮動預覽</item>
        <item>恢復全螢幕</item>
        <item>不執行動作</item>
        <item>關閉小視窗</item>
    </string-array>
    <plurals name="arkui_small_window_apps_selected">
        <item quantity="other">已選取 %d 個應用程式</item>
    </plurals>
    <string name="arkui_small_window_swipe_up">上滑分割畫面與小視窗</string>
    <string name="arkui_small_window_swipe_up_summary">從應用程式底部上滑，拖向左側入口進入分割畫面，拖向右側入口進入小視窗。放開確認，往回拖動取消，無需先在多工停留。</string>
    <string name="arkui_small_window_notification_drag">通知下拉小窗</string>
    <string name="arkui_small_window_notification_drag_summary">在支援的通知底部顯示操作條，下拉並放開可開啟可互動小窗；往回拖動可取消。</string>
    <string name="arkui_small_window_reset_category">重設</string>
</resources>
