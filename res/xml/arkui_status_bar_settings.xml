<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:title="@string/arkui_status_bar_title">
    <Preference android:key="arkui_status_bar_icons" android:title="@string/arkui_status_icons_title"
        android:summary="@string/arkui_status_icons_summary"
        android:icon="@drawable/ic_settings_system_bar_motion"
        android:fragment="com.android.settings.arkui.personalization.ArkuiStatusBarIconsSettings" />
    <SwitchPreferenceCompat android:key="arkui_status_bar_app_icons"
        android:title="@string/arkui_status_bar_app_icons_title"
        android:summary="@string/arkui_status_bar_app_icons_summary" android:persistent="false" />

    <PreferenceCategory android:title="@string/arkui_clock_category">
        <ListPreference android:key="status_bar_clock" android:title="@string/arkui_clock_position"
            android:entries="@array/arkui_clock_entries" android:entryValues="@array/arkui_clock_values" android:persistent="false" />

        <SwitchPreferenceCompat android:key="clock_seconds" android:title="@string/arkui_clock_seconds"
            android:summary="@string/arkui_clock_seconds_summary" android:persistent="false" />

        <ListPreference android:key="arkui_clock_date_style" android:title="@string/arkui_clock_date"
            android:entries="@array/arkui_date_entries" android:entryValues="@array/arkui_three_values" android:persistent="false" />

        <SwitchPreferenceCompat android:key="status_bar_clock_auto_hide" android:title="@string/arkui_clock_auto_hide"
            android:summary="@string/arkui_clock_auto_hide_summary" android:persistent="false" />

        <ListPreference android:key="status_bar_am_pm" android:title="@string/arkui_clock_ampm"
            android:entries="@array/arkui_ampm_entries" android:entryValues="@array/arkui_three_values" android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/arkui_battery_category">
        <ListPreference android:key="status_bar_battery_style" android:title="@string/arkui_battery_style"
            android:entries="@array/arkui_battery_entries" android:entryValues="@array/arkui_battery_values" android:persistent="false" />

        <ListPreference android:key="status_bar_show_battery_percent" android:title="@string/arkui_battery_percent"
            android:entries="@array/arkui_battery_percent_entries" android:entryValues="@array/arkui_three_values" android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/arkui_traffic_category">
        <ListPreference android:key="network_traffic_mode" android:title="@string/arkui_traffic_mode"
            android:entries="@array/arkui_traffic_mode_entries" android:entryValues="@array/arkui_four_values" android:persistent="false" />

        <ListPreference android:key="network_traffic_position" android:title="@string/arkui_traffic_position"
            android:entries="@array/arkui_traffic_position_entries" android:entryValues="@array/arkui_traffic_position_values" android:persistent="false" />

        <SwitchPreferenceCompat android:key="network_traffic_autohide" android:title="@string/arkui_traffic_auto_hide"
            android:summary="@string/arkui_traffic_auto_hide_summary" android:persistent="false" />

        <SwitchPreferenceCompat android:key="network_traffic_hide_arrows" android:title="@string/arkui_traffic_hide_arrows" android:persistent="false" />

        <ListPreference android:key="network_traffic_units" android:title="@string/arkui_traffic_units"
            android:entries="@array/arkui_traffic_units_entries" android:entryValues="@array/arkui_five_values" android:persistent="false" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference android:key="arkui_status_bar_note"
        android:title="@string/arkui_status_bar_note" android:selectable="false" />
</PreferenceScreen>
