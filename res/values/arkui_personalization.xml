    <string name="arkui_font_note">Google Sans Flex remains the default. The selection changes system interface fonts immediately; apps with their own fonts may keep them. Unsupported characters, including Chinese in Latin-only fonts, use system fallback fonts. Font licenses are available in the system open-source licenses.</string>
    <string name="arkui_personalization_save_error">Could not save the selection</string>
    <string name="arkui_compatibility_title">Advanced compatibility</string>
    <string name="arkui_compatibility_summary">Screenshot restrictions, APK signatures and app downgrades</string>
    <string name="arkui_capture_category">Screen capture</string>
    <string name="arkui_install_category">App installation</string>
    <string name="arkui_ignore_secure_title">Ignore secure screenshot flag</string>
    <string name="arkui_ignore_secure_summary">Ignore app window FLAG_SECURE for screenshots and recordings. Device policy and sensitive content protection still apply. Protected DRM video may remain black.</string>
    <string name="arkui_block_capture_detection_title">Block screenshot detection</string>
    <string name="arkui_block_capture_detection_summary">Do not deliver Android screenshot callbacks to apps. Apps may use other detection methods.</string>
    <string name="arkui_disable_signature_title">Allow cross-signature installation</string>
    <string name="arkui_disable_signature_summary">Allow a differently signed APK to replace an ordinary app and retain its data. This applies to all users, excluding system apps and shared UIDs. This option does not disable APK integrity or signature permission checks.</string>
    <string name="arkui_disable_apk_signature_title">Disable APK signature verification</string>
    <string name="arkui_disable_apk_signature_summary">Allow APKs whose signed contents have changed to be installed. APKs must still contain readable signing certificates. Independent of cross-signature installation; applies to all users. APEX and incremental installs keep normal verification.</string>
    <string name="arkui_downgrade_title">Allow app downgrades</string>
    <string name="arkui_downgrade_summary">Install an older version of an ordinary app without uninstalling it. Applies to all users. Older versions may not understand data created by newer versions.</string>
    <string name="arkui_compatibility_owner_note">Only the device owner user can change installation compatibility, because installed APKs are shared across users.</string>
    <string name="arkui_compatibility_note">All options are off by default and take effect without a restart. Ignoring capture restrictions can expose private screen content; allowing another signing key lets a replacement app read the previous app data. Disabling APK verification allows modified packages to be installed. Enable an option only when you need it.</string>
